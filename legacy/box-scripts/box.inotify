#!/system/bin/sh

scripts_dir="${0%/*}"
BOX_DIR="${BOX_HOME:-/data/adb/box}"
service_path="${scripts_dir}/box.service"
iptables_path="${scripts_dir}/box.iptables"
run_path="${BOX_DIR}/run"
events="$1"
monitor_file="$3"
. "${BOX_DIR}/settings.base.sh"

write_inotify_error() {
  mkdir -p "${run_path}" >/dev/null 2>&1 || true
  local previous_box_log="${box_log}"
  box_log="${run_path}/inotify_report.log"
  log Error "$*" >/dev/null
  box_log="${previous_box_log}"
}

service_control() {
  if [ "${monitor_file}" = "disable" ]; then
    if [ "${events}" = "d" ]; then
      "${service_path}" start > "${run_path}/inotify.log" 2>&1 &&
      "${iptables_path}" enable >> "${run_path}/inotify.log" 2>&1
    elif [ "${events}" = "n" ]; then
      "${iptables_path}" disable >> "${run_path}/inotify.log" 2>&1 &&
      "${service_path}" stop >> "${run_path}/inotify.log" 2>&1
    fi
  fi
}

mkdir -p "${run_path}" >/dev/null 2>&1 || true
if settings_load; then
  service_control
else
  write_inotify_error "settings.json 不存在或无法加载"
  exit 1
fi
